SELECT Product, SUM(Quantity) AS TotalUnitsSold FROM Sales GROUP BY Product ORDER BY TotalUnitsSold DESC;

SELECT CustomerName, SUM(Quantity * Price) AS TotalSpending FROM Sales GROUP BY CustomerName ORDER BY TotalSpending DESC;

SELECT YEAR(SaleDate) AS SalesYear, MONTH(SaleDate) AS SalesMonth, SUM(Quantity * Price) AS TotalRevenue FROM Sales GROUP BY YEAR(SaleDate), MONTH(SaleDate) ORDER BY SalesYear, SalesMonth;

SELECT Product, SUM(Quantity * Price) AS TotalRevenue FROM Sales GROUP BY Product HAVING SUM(Quantity * Price) > 5000 ORDER BY TotalRevenue DESC;

SELECT Product, SUM(Quantity * Price) AS TotalRevenue, RANK() OVER (ORDER BY SUM(Quantity * Price) DESC) AS RevenueRank FROM Sales GROUP BY Product ORDER BY RevenueRank;
